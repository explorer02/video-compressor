<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      mediaProcessing is the correct type for a user-initiated encode on API 35+; dataSync is what
      API 29-34 use. Both bits are declared so startForeground can pass either.
    -->
    <service
      android:name=".CompressionForegroundService"
      android:exported="false"
      android:foregroundServiceType="mediaProcessing|dataSync" />
  </application>
</manifest>
